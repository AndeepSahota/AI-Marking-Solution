# Copy this file to local.env and adjust for your hardware.
# local.env is gitignored and must never be committed — it's machine-specific.

# TORCH_DEVICE controls which backend the model runs on:
#   mps  - Apple Silicon (M1/M2/M3) GPU
#   cuda - Nvidia GPU
#   cpu  - no GPU acceleration
TORCH_DEVICE=cpu

# TORCH_ATTN=eager avoids issues with optimised attention kernels that
# aren't available on every platform.
TORCH_ATTN=eager
