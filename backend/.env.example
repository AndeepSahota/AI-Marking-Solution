# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.

PORT=3001
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Used to sign/verify session JWTs. Generate your own — it does not need to
# match anyone else's value, it just needs to exist for your local backend.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Used to pre-hash passwords/emails before bcrypt/storage. Generate your own —
# it does not need to match anyone else's value, it just needs to exist.
# Generate with: openssl rand -hex 32
PASSWORD_PEPPER=
EMAIL_PEPPER=

# PostgreSQL connection string (used once the backend migrates from SQLite to pg).
# Local dev points at the docker-compose Postgres below; Azure uses the Flexible
# Server host with sslmode=require, injected from Key Vault.
DATABASE_URL=postgres://aimira:localdevpassword@localhost:5432/aimira
